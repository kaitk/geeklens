{
  "manifest_version": 3,
  "permissions": ["storage"],
  "{{chrome}}.host_permissions": ["*://browser.geekbench.com/*"],
  "{{chrome}}.minimum_chrome_version": "111",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "{{firefox}}.browser_specific_settings": {
    "gecko": {
      "id": "{a7334511-e94e-4f9a-b808-86dc8d92748b}",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "{{chrome}}.service_worker": "src/background.ts",
    "{{firefox}}.scripts": ["src/background.ts"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://browser.geekbench.com/v5/cpu/*",
        "*://browser.geekbench.com/v6/cpu/*",
        "*://browser.geekbench.com/v7/cpu/*"
      ],
      "js": ["src/content/contentScript.ts"]
    }
  ]
}
