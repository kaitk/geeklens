{
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "name": "GeekLens",
  "version": "0.4.0",
  "description": "Enhances Geekbench CPU benchmark results with instruction set information",
  "permissions": ["activeTab", "storage"],
  "{{chrome}}.host_permissions": ["*://browser.geekbench.com/*"],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "{{chrome}}.action": {
    "default_popup": "src/popup.html"
  },
  "{{firefox}}.browser_action": {
    "default_popup": "src/popup.html"
  },
  "{{firefox}}.browser_specific_settings": {
    "gecko": {
      "id": "{a7334511-e94e-4f9a-b808-86dc8d92748b}",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "{{chrome}}.service_worker": "src/background.ts",
    "{{firefox}}.scripts": ["src/background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["*://browser.geekbench.com/v6/cpu/*", "*://browser.geekbench.com/v7/cpu/*"],
      "js": ["src/content/contentScript.ts"]
    }
  ]
}
