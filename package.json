{
  "name": "GeekLens",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "vite build",
    "build:chrome": "TARGET=chrome vite build",
    "build:firefox": "TARGET=firefox vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "validate": "bun run format:check && bun run lint && bun test && bun run check",
    "zip": "bun run build && bun scripts/zip.ts",
    "release:chrome": "bun run build:chrome && bun scripts/zip.ts chrome",
    "release:firefox": "bun run build:firefox && bun scripts/zip.ts firefox"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/webextension-polyfill": "^0.10.0",
    "linkedom": "^0.18.13",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tslib": "^2.6.3",
    "typescript": "~5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-web-extension": "^4.5.1",
    "webextension-polyfill": "^0.10.0",
    "zip-a-folder": "^3.1.9"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "bun@1.3.14"
}
